{
  "branch": "mfi-edge-stage23",
  "experiments_file": "automation/stage23_experiments.json",
  "start_experiment": "stage23a_descriptor_aggregator_landscape_planning",
  "default_model": "gpt-5.6-sol",
  "max_iterations": 1000000,
  "max_codex_calls": 1000000,
  "max_wall_hours": 87600,
  "experiment_timeout_minutes": 360,
  "codex_timeout_minutes": 40,
  "codex_retries": 2,
  "reasoning_effort": "medium",
  "research_reasoning_effort": "high",
  "research_web_search": "live",
  "research_web_search_fallbacks": [
    "live",
    "indexed",
    "disabled"
  ],
  "research_fallback_to_normal_codex": true,
  "analysis_retry_backoff_seconds": 20,
  "analysis_retry_backoff_max_seconds": 300,
  "autonomous_research_fallback": "stage23_literature_escalation",
  "research_agenda_file": "docs/paper/STAGE23_EVIDENCE_AGGREGATION_CAMPAIGN.md",
  "require_visual_preview": true,
  "visual_preview_filename": "best_method_preview.png",
  "official_evaluation": {
    "enabled": true,
    "run_before_codex": true,
    "module": "evaluation/bsds_official/run_official_bsds.py",
    "config": "evaluation/bsds_official/config.json",
    "manifest_filename": "official_eval_manifest.json",
    "feedback_allowed_splits": [
      "train",
      "val"
    ],
    "protected_splits": [
      "test"
    ],
    "require_for_image_development": true,
    "require_completed_for_promotion": true,
    "failure_policy": "report_and_continue"
  },
  "auto_commit": true,
  "auto_push": true,
  "remote": "origin",
  "protected_paths": [
    "run_stage12d_bipolar_cv.py",
    "src/bipolar_fuzzy.py",
    "src/edge_signature.py",
    "src/edge_signature_relational.py"
  ],
  "validation_commands": [
    [
      "git",
      "diff",
      "--check"
    ]
  ]
}
